# Roteamento das hotpages (WDLC 2.1). Docroot: public/
# A query string é preservada (sem QSD), então os UTM chegam intactos ao index.php.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rotas das hotpages. Ao criar um nicho, incluir o slug aqui e em config/pages.php.
    RewriteRule ^(imobiliario|saude|consumidor)/?$ index.php [L]

    # Arquivos e diretórios reais são servidos direto; o resto vai para o 404 do index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
